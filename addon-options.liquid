{% comment %}
  Addon Options Snippet
  Renders add-on product options as separate line items with variant IDs
  Supports both data-variant-id and data-addon-variant-id attributes (legacy)
{% endcomment %}

{% assign addon_products = block.settings.addon_products | split: ',' %}
{% if addon_products.size > 0 %}
<div id="product-addons-{{ section.id }}" class="addon-options">
  <h4 class="addon-options__title">{{ block.settings.addons_title | default: 'Add-ons' }}</h4>
  <div class="addon-options__list">
    {% for addon_handle in addon_products %}
      {% assign addon_handle = addon_handle | strip %}
      {% assign addon = all_products[addon_handle] %}
      {% if addon and addon.available %}
        {% assign addon_variant = addon.selected_or_first_available_variant %}
        <label class="addon-options__item">
          <input
            type="checkbox"
            class="addon-options__checkbox"
            data-variant-id="{{ addon_variant.id }}"
            data-addon-variant-id="{{ addon_variant.id }}"
            value="{{ addon_variant.id }}"
            data-addon-price="{{ addon_variant.price }}"
            data-addon-title="{{ addon.title | escape }}"
            data-addon-sku="{{ addon_variant.sku | escape }}"
          />
          <span class="addon-options__label">{{ addon.title }}</span>
          <span class="addon-options__price">+ {{ addon_variant.price | money }}</span>
        </label>
      {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}
